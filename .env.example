ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=   # only for user-scoped keys (sk-ant-usr-...); Console > Settings > Workspaces
SERPER_API_KEY=            # web search for the source watcher
MATRIX_LLM=anthropic/claude-sonnet-4-5
HITL_MODE=file             # console | file
EVIDENCE_BACKEND=local     # local = data/evidence/<row-id>_*.pdf ; empty = not configured (auditor reports unknown)
MATRIX_WORKERS=4           # parallel source checks
CREWAI_TRACING_ENABLED=false
EXPORT_LANG=pt             # pt | en — language of the exported workbook (row text stays in English)
